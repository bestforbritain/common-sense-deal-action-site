# Copy to .env.local for local development. Never commit real values.
# Without the Supabase variables the site uses data/constituencies.json, keeps letters
# in memory, and gives you a development-only admin login.

# Supabase (server-only; never expose to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase "anon"/publishable key, used only for admin sign-in (magic links)
SUPABASE_ANON_KEY=

# Staff who can use /admin (comma-separated email addresses)
ADMIN_EMAILS=

# Salt for hashing IPs in rate-limit keys (any long random string)
RATE_LIMIT_SALT=

# Vercel sends this as a Bearer token to the cron routes
CRON_SECRET=

# Cloudflare Turnstile bot check
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Stannp. Letters are only posted for real when STANNP_LIVE is "true" AND the admin
# "Live posting" setting is on AND this is the live Vercel deployment. Never set
# STANNP_LIVE in local or preview environments.
STANNP_API_KEY=
STANNP_LIVE=
# Secret set on the Stannp webhook; the site refuses webhooks without it
STANNP_WEBHOOK_SECRET=
