# Copy to .env.local for local development. Never commit real values.
# Without the Supabase variables, the site reads MPs from data/constituencies.json
# and rate-limits in memory.

# Supabase (server-only; never expose to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Salt for hashing IPs in rate-limit keys (any long random string)
RATE_LIMIT_SALT=

# Vercel sends this as a Bearer token to /api/cron/refresh-mps
CRON_SECRET=
